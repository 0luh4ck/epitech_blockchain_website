# Fichier d'exemple des variables d'environnement pour le frontend
# Copiez ce fichier en .env et remplissez les valeurs

# API Backend URL
VITE_API_URL=http://localhost:5000/api

# App Info
VITE_APP_NAME=Club Blockchain Epitech Bénin
VITE_APP_VERSION=1.0.0

# Features (optionnel)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Route confidentielle de connexion Superadmin (obscurcie, non liée publiquement)
VITE_SUPERADMIN_ROUTE=/portal-secure-x9k2/admin-login
