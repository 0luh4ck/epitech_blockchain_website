# Fichier d'exemple des variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs

# Environment
NODE_ENV=development

# Server
PORT=5000

# Base de données MySQL / TiDB Cloud Serverless
# Local : DB_HOST=localhost, DB_PORT=3306, DB_SSL=false
# Prod (Render + TiDB) : DB_HOST=<xxx.tidbcloud.com>, DB_PORT=4000, DB_SSL=true
# (le TLS est de toute façon forcé automatiquement quand NODE_ENV=production)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=epitech_blockchain_club
DB_SSL=false
# Optionnel : URI complète, prioritaire sur DB_* si définie
# DATABASE_URL=mysql://user:password@host:4000/epitech_blockchain_club

# URL publique de l'API (utilisée par Swagger /api/docs)
# API_PUBLIC_URL=http://localhost:5000/api

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (optionnel - pour les notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@epitech-blockchain.bj

# Upload (optionnel)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Logs
LOG_LEVEL=info
